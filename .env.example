# =============================================================================
# WANSOM AI - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/wansom?schema=public"

# -----------------------------------------------------------------------------
# AUTHENTICATION (NextAuth.js)
# -----------------------------------------------------------------------------
# Base URL for your application
NEXTAUTH_URL="http://localhost:3000"

# Secret for NextAuth JWT - generate with: openssl rand -hex 64
NEXTAUTH_SECRET=""

# Legacy JWT secrets (used for custom token handling)
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# -----------------------------------------------------------------------------
# GOOGLE OAUTH
# -----------------------------------------------------------------------------
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_AUTH_CLIENT_ID=""
GOOGLE_AUTH_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# AI / GEMINI
# -----------------------------------------------------------------------------
# Get from: https://aistudio.google.com/app/apikey
# Only one is required - GOOGLE_API_KEY takes precedence if both are set
GOOGLE_API_KEY=""
# Primary platform AI key and model (used by chat, associates, documents, RAG, etc.)
WANSOM_API_KEY=""
WANSOM_MODEL="gemini-3-flash-preview"
# Briefly (legal digest) uses a separate key and model
BRIEFLY_API_KEY=""
BRIEFLY_MODEL="gemini-3-flash-preview"

# -----------------------------------------------------------------------------
# FILE STORAGE (Vercel Blob)
# -----------------------------------------------------------------------------
# Get from Vercel Dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=""

# -----------------------------------------------------------------------------
# EMAIL (SMTP)
# -----------------------------------------------------------------------------
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""

# Comma-separated list of emails for admin notifications
NOTIFICATION_EMAILS=""
NOTIFICATION_FROM=""
ADMIN_EMAIL=""

# -----------------------------------------------------------------------------
# CMS - SANITY (Primary)
# -----------------------------------------------------------------------------
# Get from: https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# -----------------------------------------------------------------------------
# CMS - CONTENTFUL (Legacy - Optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CONTENTFUL_SPACE_ID=""
# NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=""

# -----------------------------------------------------------------------------
# PUBLIC URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# ANALYTICS (Optional)
# -----------------------------------------------------------------------------
# Microsoft Clarity - Get from: https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# -----------------------------------------------------------------------------
# ADMIN ACCESS
# -----------------------------------------------------------------------------
# Comma-separated list of admin email addresses
ADMIN_EMAILS=""

# -----------------------------------------------------------------------------
# PAYMENTS (Paystack)
# -----------------------------------------------------------------------------
# Get from Paystack Dashboard: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Your subscription plan code from Paystack (e.g., "PLN_xxxxxxxxxxxx")
PAYSTACK_PLAN_CODE=""

# Paystack plan code for Teams plan ($15/seat/month)
PAYSTACK_TEAMS_PLAN_CODE=""

# Briefly by Wansom subscription plan codes
# USD plan ($10) - used when jurisdictions do NOT include Kenya
LAW360_PLAN_CODE=""
# KES plan (KES 1,000) - used when Kenya is selected as a jurisdiction
LAW360KENYA_PLAN_CODE=""

# -----------------------------------------------------------------------------
# GOOGLE CLOUD SERVICE ACCOUNT (Optional - for Drive .doc conversion and OCR)
# -----------------------------------------------------------------------------
# Used by: import-doc route (binary .doc → Drive → .docx) and Cloud Vision OCR.
#
# Two ways to provide credentials — pick ONE:
#
#   Option A — Inline JSON string (recommended for Vercel / CI / team sharing):
#     Paste the minified service-account JSON as a single line.
#     Get it by running: cat google-credentials.json | jq -c .
#     Then store the output in your secrets manager and set it here.
#
GOOGLE_SERVICE_ACCOUNT_KEY=""
#
#   Option B — File path (local development only, never commit the file):
#     Keep google-credentials.json locally (it is gitignored) and point here.
#
# GOOGLE_APPLICATION_CREDENTIALS="./google-credentials.json"
#
# Additional vars for Cloud Vision OCR (only if using Vision API):
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_CLOUD_STORAGE_BUCKET=""

# -----------------------------------------------------------------------------
# GOOGLE CUSTOM SEARCH (Required for legal citation verification)
# -----------------------------------------------------------------------------
# Powers the verifyLegalCitation tool — searches official legal databases
# (Kenya Law, AfricanLII, UK Legislation, etc.) in real-time via Google.
# Without this, citation verification will fail and the AI will tell users
# it could not verify the citation.
#
# Setup:
#  1. Enable "Custom Search API" at https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#  2. Create a Search Engine at https://programmablesearch.google.com/
#     - Under "Sites to search", choose "Search the entire web"
#     - Copy the Search Engine ID (cx)
#  3. Create an API key at https://console.cloud.google.com/apis/credentials
#     (can reuse an existing key — just ensure Custom Search API is enabled for it)
#
# Cost: $5 per 1,000 queries (no daily cap). ~100 free queries/day on free tier.
GOOGLE_API_KEY=""
GOOGLE_CSE_ID=""
