# =============================================================================
# WANSOM AI - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/wansom?schema=public"

# -----------------------------------------------------------------------------
# AUTHENTICATION (NextAuth.js)
# -----------------------------------------------------------------------------
# Base URL for your application
NEXTAUTH_URL="http://localhost:3000"

# Secret for NextAuth JWT - generate with: openssl rand -hex 64
NEXTAUTH_SECRET=""

# Legacy JWT secrets (used for custom token handling)
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# -----------------------------------------------------------------------------
# GOOGLE OAUTH
# -----------------------------------------------------------------------------
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_AUTH_CLIENT_ID=""
GOOGLE_AUTH_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# AI / GEMINI
# -----------------------------------------------------------------------------
# Get from: https://aistudio.google.com/app/apikey
# Only one is required - GOOGLE_API_KEY takes precedence if both are set
GOOGLE_API_KEY=""
# GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview"

# -----------------------------------------------------------------------------
# FILE STORAGE (Vercel Blob)
# -----------------------------------------------------------------------------
# Get from Vercel Dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=""

# -----------------------------------------------------------------------------
# EMAIL (SMTP)
# -----------------------------------------------------------------------------
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""

# Comma-separated list of emails for admin notifications
NOTIFICATION_EMAILS=""
NOTIFICATION_FROM=""
ADMIN_EMAIL=""

# -----------------------------------------------------------------------------
# CMS - SANITY (Primary)
# -----------------------------------------------------------------------------
# Get from: https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# -----------------------------------------------------------------------------
# CMS - CONTENTFUL (Legacy - Optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CONTENTFUL_SPACE_ID=""
# NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=""

# -----------------------------------------------------------------------------
# PUBLIC URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# ANALYTICS (Optional)
# -----------------------------------------------------------------------------
# Microsoft Clarity - Get from: https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# -----------------------------------------------------------------------------
# ADMIN ACCESS
# -----------------------------------------------------------------------------
# Comma-separated list of admin email addresses
ADMIN_EMAILS=""

# -----------------------------------------------------------------------------
# PAYMENTS (Paystack)
# -----------------------------------------------------------------------------
# Get from Paystack Dashboard: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Your subscription plan code from Paystack (e.g., "PLN_xxxxxxxxxxxx")
PAYSTACK_PLAN_CODE=""

# Briefly by Wansom subscription plan codes
# USD plan ($10) - used when jurisdictions do NOT include Kenya
LAW360_PLAN_CODE=""
# KES plan (KES 1,000) - used when Kenya is selected as a jurisdiction
LAW360KENYA_PLAN_CODE=""

# -----------------------------------------------------------------------------
# GOOGLE CLOUD (Optional - for advanced OCR)
# -----------------------------------------------------------------------------
# Only needed if using Google Cloud Vision API for scanned PDF OCR
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"
# GOOGLE_CLOUD_PROJECT_ID=""
# GOOGLE_CLOUD_STORAGE_BUCKET=""
