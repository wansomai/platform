[Unit]
Description=LII Scraper Service
After=network.target

[Service]
Type=simple
User=lii
Group=lii
WorkingDirectory=/opt/lii-scraper
EnvironmentFile=/opt/lii-scraper/.env
ExecStart=/opt/lii-scraper/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --timeout 60 \
    --access-logfile /var/log/lii-scraper/access.log \
    --error-logfile /var/log/lii-scraper/error.log \
    app:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
