{
  "functions": {
    "src/app/api/documents/route.ts": {
      "memory": 1024
    },
    "src/app/api/projects/[id]/conversations/[conversationId]/messages/route.ts": {
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/trial-expiry",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/subscription-renewal",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/digest-ingest?tier=1",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/digest-ingest?tier=2",
      "schedule": "30 */4 * * *"
    },
    {
      "path": "/api/cron/legal-digest",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/digest-cleanup",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/notification-cleanup",
      "schedule": "0 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://wansom.ai/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "wakili.chat"
        }
      ]
    }
  ]
}
